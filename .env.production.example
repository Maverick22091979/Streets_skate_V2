APP_NAME=Street Skate Login
APP_ENV=production
BASE_URL=https://streetskate.create-to-live.com
HOST=0.0.0.0
PORT=5000
SESSION_COOKIE_NAME=street_skate_session
APP_SECRET_KEY_FILE=/run/secrets/app_secret_key
SESSION_SAME_SITE=lax
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_BROWSER_CLOSE=true
SESSION_COOKIE_MAX_AGE_SEC=1209600
SESSION_INACTIVITY_TIMEOUT_SEC=180
SECURITY_ENABLE_HSTS=true
SECURITY_HSTS_MAX_AGE=31536000

DATABASE_URL_FILE=/run/secrets/database_url
POSTGRES_DB=street_skate
POSTGRES_USER=street_skate
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

ADMIN_USERNAME=admin
ADMIN_PASSWORD_FILE=/run/secrets/admin_password

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET_FILE=/run/secrets/strava_client_secret
STRAVA_REDIRECT_URI=https://streetskate.create-to-live.com/auth/strava/callback
STRAVA_AUTHORIZE_URL=https://www.strava.com/oauth/authorize
STRAVA_TOKEN_URL=https://www.strava.com/oauth/token
STRAVA_USER_URL=https://www.strava.com/api/v3/athlete
STRAVA_ACTIVITIES_URL=https://www.strava.com/api/v3/athlete/activities
STRAVA_SCOPE=read,activity:read_all,profile:read_all

MAPMYRUN_CLIENT_ID=
MAPMYRUN_CLIENT_SECRET_FILE=/run/secrets/mapmyrun_client_secret
MAPMYRUN_REDIRECT_URI=https://streetskate.create-to-live.com/auth/mapmyrun/callback
MAPMYRUN_AUTH_URL=https://www.mapmyfitness.com/oauth2/authorize/
MAPMYRUN_TOKEN_URL=https://api.mapmyfitness.com/v7.1/oauth2/access_token/
MAPMYRUN_USER_URL=https://api.mapmyfitness.com/v7.1/user/self/
MAPMYRUN_ACTIVITIES_URL=https://api.mapmyfitness.com/v7.1/workout/
MAPMYRUN_SCOPE=
MAPMYRUN_REVOKE_URL=https://api.mapmyfitness.com/v7.1/oauth2/connection/

SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET_FILE=/run/secrets/suunto_client_secret
SUUNTO_SUBSCRIPTION_KEY_FILE=/run/secrets/suunto_subscription_key
SUUNTO_REDIRECT_URI=https://streetskate.create-to-live.com/auth/suunto/callback
SUUNTO_AUTH_URL=https://cloudapi-oauth.suunto.com/oauth/authorize
SUUNTO_TOKEN_URL=https://cloudapi-oauth.suunto.com/oauth/token
SUUNTO_USER_URL=
SUUNTO_ACTIVITIES_URL=https://cloudapi.suunto.com/v2/workouts
SUUNTO_SCOPE=workout
SUUNTO_REVOKE_URL=

RUNKEEPER_CLIENT_ID=
RUNKEEPER_CLIENT_SECRET_FILE=/run/secrets/runkeeper_client_secret
RUNKEEPER_REDIRECT_URI=https://streetskate.create-to-live.com/auth/runkeeper/callback
RUNKEEPER_AUTH_URL=https://runkeeper.com/apps/authorize
RUNKEEPER_TOKEN_URL=https://runkeeper.com/apps/token
RUNKEEPER_USER_URL=https://api.runkeeper.com/user
RUNKEEPER_ACTIVITIES_URL=https://api.runkeeper.com/fitnessActivities
RUNKEEPER_SCOPE=profile activity
RUNKEEPER_REVOKE_URL=

GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET_FILE=/run/secrets/garmin_client_secret
GARMIN_REDIRECT_URI=https://streetskate.create-to-live.com/auth/garmin/callback
GARMIN_AUTH_URL=
GARMIN_TOKEN_URL=
GARMIN_USER_URL=
GARMIN_ACTIVITIES_URL=
GARMIN_SCOPE=
GARMIN_REVOKE_URL=

INLINE_ROUTE_TRACKING_CLIENT_ID=
INLINE_ROUTE_TRACKING_CLIENT_SECRET_FILE=/run/secrets/inline_route_tracking_client_secret
INLINE_ROUTE_TRACKING_REDIRECT_URI=https://streetskate.create-to-live.com/auth/inline_route_tracking/callback
INLINE_ROUTE_TRACKING_AUTH_URL=
INLINE_ROUTE_TRACKING_TOKEN_URL=
INLINE_ROUTE_TRACKING_USER_URL=
INLINE_ROUTE_TRACKING_ACTIVITIES_URL=
INLINE_ROUTE_TRACKING_SCOPE=
INLINE_ROUTE_TRACKING_REVOKE_URL=

ADIDAS_CLIENT_ID=
ADIDAS_CLIENT_SECRET_FILE=/run/secrets/adidas_client_secret
ADIDAS_REDIRECT_URI=https://streetskate.create-to-live.com/auth/adidas/callback
ADIDAS_AUTH_URL=
ADIDAS_TOKEN_URL=
ADIDAS_USER_URL=
ADIDAS_ACTIVITIES_URL=
ADIDAS_SCOPE=
ADIDAS_EXPORT_DIR=data/export/Sport-sessions/GPS-data
ADIDAS_EXPORT_USER_DIR=data/export/User

OVERPASS_API_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.maprva.org/api/interpreter,https://overpass-api.de/api/interpreter
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
MIN_IMPORT_DISTANCE_M=500
SLOPE_SMOOTHING_WINDOW=5
SLOPE_MIN_RUN_DISTANCE_M=20
SLOPE_MAX_CAP_PCT=35
VIEWER_SHOW_DIRECTION_ARROWS=true
GOOGLE_MAPS_API_KEY=

DIFFICULTY_WEIGHT_MAX_SLOPE=25
DIFFICULTY_WEIGHT_WEIGHTED_SLOPE=25
DIFFICULTY_WEIGHT_SURFACE=15
DIFFICULTY_WEIGHT_SMOOTHNESS=0
DIFFICULTY_WEIGHT_PRESSURE=5
DIFFICULTY_WEIGHT_TEMPERATURE=20
DIFFICULTY_WEIGHT_SEGMENT_SPEED=10

DUPLICATE_DISTANCE_DIFF_PCT=5
DUPLICATE_ENDPOINT_TOLERANCE_M=300
DUPLICATE_ALLOW_REVERSE_MATCH=true
